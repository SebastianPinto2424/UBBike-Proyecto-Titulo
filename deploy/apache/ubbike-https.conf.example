<VirtualHost *:80>
  ServerName <DOMINIO_O_IP_PUBLICA>
  RewriteEngine On
  RewriteRule ^/?(.*) https://%{SERVER_NAME}/$1 [R=301,L]
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
  ServerName <DOMINIO_O_IP_PUBLICA>

  SSLEngine on
  SSLCertificateFile /etc/letsencrypt/live/<DOMINIO_O_IP_PUBLICA>/fullchain.pem
  SSLCertificateKeyFile /etc/letsencrypt/live/<DOMINIO_O_IP_PUBLICA>/privkey.pem

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  ProxyPreserveHost On
  ProxyRequests Off

  RewriteEngine On
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^/socket.io/(.*) ws://127.0.0.1:3000/socket.io/$1 [P,L]

  ProxyPass / http://127.0.0.1:3000/ retry=0
  ProxyPassReverse / http://127.0.0.1:3000/

  ErrorLog ${APACHE_LOG_DIR}/ubbike_error.log
  CustomLog ${APACHE_LOG_DIR}/ubbike_access.log combined
</VirtualHost>
</IfModule>
