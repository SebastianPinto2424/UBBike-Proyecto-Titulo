{
  "name": "ubbike-backend",
  "version": "1.0.0",
  "description": "Backend API REST para UBBike.",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "npm run generate && tsx watch src/servidor.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/servidor.js",
    "quitar-demo": "node dist/scripts/quitar-usuarios-demo.js",
    "generate": "prisma generate && node scripts/ajustar-dbml.mjs",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "npm run generate && tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/generated/**\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"publico/**/*.js\" \"!src/generated/**\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"publico/**/*.js\" \"!src/generated/**\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts"
  },
  "keywords": [
    "ubbike",
    "bicicletero",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "prisma": "^7.8.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "mysql2": "^3.24.0",
    "cross-spawn": "^7.0.6",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.8.3",
    "prisma-dbml-generator": "^0.12.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
