# Copia este archivo como .env y completa los valores marcados.
# Lo usan docker compose y el backend. Nunca subas el .env con datos reales.

# --- Base de datos ---
POSTGRES_DB=ubbike
POSTGRES_USER=ubbike
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Solo para ejecutar el backend fuera de Docker. Con Docker se arma solo.
# DATABASE_URL=postgresql://ubbike:CLAVE@localhost:5433/ubbike?schema=public

# --- Redis ---
REDIS_PORT=6380
# Obligatorio en produccion: sin Redis no se renuevan las sesiones.
# REDIS_URL=redis://127.0.0.1:6379
# REQUIRE_REDIS_RATE_LIMIT=true

# --- Puertos y direcciones ---
BACKEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
FRONTEND_BIND_ADDRESS=127.0.0.1

# --- Direcciones publicas ---
# La app web y el APK guardan esta URL al compilar: si cambia hay que
# reconstruir el frontend, no alcanza con reiniciar.
# Para probar en celulares usa la IP del equipo, no localhost.
PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_WS_BASE_URL=ws://localhost:3000
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Las mismas direcciones vistas desde los contenedores.
DOCKER_FRONTEND_URL=http://localhost:8081
DOCKER_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Sesiones ---
# Cadena larga y aleatoria, minimo 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_ISSUER=ubbike-api
JWT_AUDIENCE=ubbike-app
REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Aplicacion ---
QR_DURATION_SECONDS=15
SEED_DEMO_DATA=true
SWAGGER_ENABLED=false
# Multiplica los limites de intentos. Subelo solo para pruebas.
RATE_LIMIT_FACTOR=1
# Necesario detras de Apache o nginx para leer la IP real del cliente.
# TRUST_PROXY=1

# --- Notificaciones push ---
# Ruta al JSON de la cuenta de servicio de Firebase. Si se deja vacio el
# backend arranca igual, pero sin enviar push.
FIREBASE_CREDENTIALS_PATH=

# --- Correo ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=UBBike <no-responder@ubiobio.cl>

# --- Mapa ---
# Vacios usan OpenStreetMap y Esri por defecto. Cambiar el proveedor obliga a
# permitirlo tambien en mobile/nginx.conf.
MAP_TILE_URL=
MAP_SATELLITE_URL=
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
MAP_CAMPUS_LAT=-36.821728
MAP_CAMPUS_LNG=-73.011604
